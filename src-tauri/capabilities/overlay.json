{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Select-to-Ask overlays: only the capture commands.",
  "windows": ["overlay-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-ui-ready",
    "allow-capture-preview",
    "allow-capture-select",
    "allow-capture-select-lasso",
    "allow-capture-cancel"
  ]
}
